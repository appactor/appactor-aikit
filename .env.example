NODE_ENV=development
PORT=3100
LOG_LEVEL=info
MCP_RESOURCE_URL=http://127.0.0.1:3100/mcp
MCP_AUTH_ISSUER=http://127.0.0.1:3002/api/auth
MCP_AUTH_JWKS_URL=http://127.0.0.1:3002/api/auth/jwks
APPACTOR_API_URL=http://127.0.0.1:3001
# PKCS#8 PEM, with literal \n accepted in deployment environment values.
MCP_INTERNAL_JWT_PRIVATE_KEY=
MCP_INTERNAL_JWT_KEY_ID=appactor-mcp-v1
MCP_INTERNAL_JWT_ISSUER=appactor-mcp
MCP_INTERNAL_JWT_AUDIENCE=appactor-api
MCP_METRICS_AUTH_TOKEN=replace-with-at-least-32-random-characters
APPACTOR_API_TIMEOUT_MS=8000
